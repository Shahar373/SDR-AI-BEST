# SDR Agent environment configuration
# Copy this to .env and fill in the secrets.
# NEVER commit .env to git.

# ── Secrets (fill in) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Storage ───────────────────────────────────────────────────────────────
# Path to the SSD where the knowledge base and artifacts are stored.
# The provisioning script will set this based on what it detects.
# If no SSD is mounted, defaults to ~/sdr-data.
SDR_DATA_DIR=/mnt/sdr-ssd/sdr-agent

# Ramdisk for transient IQ captures. Defaults to /dev/shm/sdr-iq (tmpfs on Pi OS).
SDR_IQ_DIR=/dev/shm/sdr-iq

# Hard caps for IQ captures
SDR_IQ_MAX_SECS=60
SDR_IQ_MAX_MB=256

# Max IQ captures per sweep cycle (curiosity budget)
SDR_MAX_IQ_CAPTURES_PER_CYCLE=5

# ── SDR hardware ──────────────────────────────────────────────────────────
# SoapySDR driver string for RSP1B
SOAPY_DRIVER=SoapySDRPlay3

# RSP1B antenna port (A = LNA port, B = 50Ω, C = ANT C / Hi-Z)
# Default: "Antenna C" (wideband)
RSP1B_ANTENNA=Antenna C

# ── Agent tuning ─────────────────────────────────────────────────────────
# Minimum SNR (dB) to consider a signal worth investigating
MIN_SIGNAL_SNR=10

# Sweep dwell time per 10 MHz chunk (seconds)
SWEEP_DWELL_SECS=1.0

# Heartbeat interval (minutes) — also set in OpenClaw cron
HEARTBEAT_INTERVAL_MIN=30
